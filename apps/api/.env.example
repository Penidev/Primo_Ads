# --- Core (required) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://primo:primo_dev@postgres:5432/primo
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars

# --- Provider mode ---
# live = call real providers (needs the API keys below)
# mock = deterministic in-process fakes; no keys, no cost, full pipeline runs.
#        Refused when ENVIRONMENT=production.
PROVIDER_MODE=live
MOCK_MEDIA_DIR=/tmp/primo-mock-media

# --- Auth tuning ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- AI providers (fill in when reaching their phase) ---
GEMINI_API_KEY=
FAL_KEY=
OPENAI_API_KEY=

# --- Payments (Phase 5) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
COZZIPAY_SECRET_KEY=
COZZIPAY_WEBHOOK_SECRET=

# --- Storage (asset/video phases) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=primo-assets
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Production notes: Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase's dashboard hands out `postgresql://...?sslmode=require`. That string
# fails twice if pasted verbatim, and the config validator refuses it for both
# reasons rather than letting them surface later:
#   1. no `+asyncpg`, so SQLAlchemy loads a sync driver
#   2. `sslmode` is libpq's keyword; asyncpg wants `ssl`, which we set from
#      DB_REQUIRE_SSL rather than from the DSN
#
# Two DSNs are needed, because they do different jobs.
#
# Runtime (transaction pooler, port 6543) — short-lived connections, which is
# what an API wants, and what keeps you inside Supabase's connection limit:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DB_BEHIND_TRANSACTION_POOLER=true
#
# Migrations (session mode, port 5432) — Alembic needs session-level behaviour
# that transaction mode does not provide, and CREATE EXTENSION wants a direct
# connection:
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# DB_REQUIRE_SSL is forced on whenever ENVIRONMENT=production; set it explicitly
# for staging.
DB_BEHIND_TRANSACTION_POOLER=false
DB_REQUIRE_SSL=false
# MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------
# Proxy topology
# ---------------------------------------------------------------------------
# Number of proxies that append to X-Forwarded-For between a browser and this
# app. Rate limiting locates the real client IP by counting back from the right,
# because the left-hand entries are supplied by the caller and can be forged.
#
# 0 ignores the header entirely and uses the socket peer. Keep it at 0 unless
# you know the hop count: too high lets a caller forge their bucket, too low
# only groups more callers together.
#
# Vercel rewrite -> container host load balancer is typically 2.
TRUSTED_PROXY_COUNT=0
